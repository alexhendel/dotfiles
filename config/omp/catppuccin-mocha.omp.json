{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "palette": {
    "rosewater": "#f5e0dc",
    "pink": "#f5c2e7",
    "mauve": "#cba6f7",
    "red": "#f38ba8",
    "peach": "#fab387",
    "yellow": "#f9e2af",
    "green": "#a6e3a1",
    "teal": "#94e2d5",
    "sky": "#89dceb",
    "blue": "#89b4fa",
    "lavender": "#b4befe",
    "text": "#cdd6f4",
    "overlay0": "#6c7086",
    "surface0": "#313244",
    "base": "#1e1e2e",
    "crust": "#11111b"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:mauve",
          "template": "{{ .Icon }} "
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:pink",
          "template": "{{ .UserName }} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:blue",
          "template": " {{ .Path }} ",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "home_icon": "~",
            "folder_separator_icon": " 󰅂 "
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}p:peach{{ end }}"
          ],
          "template": "{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "branch_icon": " "
          }
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:lavender",
          "template": " {{ .FormattedMs }} ",
          "options": {
            "threshold": 3000,
            "style": "austin"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:green",
          "template": " {{ .Full }} "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:yellow",
          "template": " {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} "
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "p:sky",
          "template": " {{ .Full }} "
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:peach",
          "template": " {{ .Full }} "
        },
        {
          "type": "kubectl",
          "style": "plain",
          "foreground": "p:blue",
          "template": "󱃾 {{ .Context }}{{ if .Namespace }}:{{ .Namespace }}{{ end }} "
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:overlay0",
          "template": " {{ .CurrentDate | date .Format }}",
          "options": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:mauve",
          "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
          "template": "❯",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "p:mauve",
    "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
    "template": "❯ "
  },
  "secondary_prompt": {
    "foreground": "p:overlay0",
    "template": "❯❯ "
  }
}
